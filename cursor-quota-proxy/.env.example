# 你的 Cursor Admin API Key（从 Dashboard → API Keys 获取，切勿泄露）
CURSOR_API_KEY=crsr_xxxxxxxxxxxxxxxx

# 代理服务管理员密钥（用于创建用户、设置配额）
ADMIN_SECRET=change-me-to-a-long-random-string

# 数据库路径
DATABASE_URL=sqlite:///./quota.db

# Cursor API 基础地址
CURSOR_API_BASE=https://api.cursor.com

# 服务监听端口
HOST=0.0.0.0
PORT=8080
